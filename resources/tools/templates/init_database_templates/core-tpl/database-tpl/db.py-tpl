import traceback

from loguru import logger
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker, Session, DeclarativeBase
from contextlib import contextmanager

from modules.config import config


Engine = create_engine(config.{{ connect_name }}, echo=config.DEBUG)
SessionMaker = sessionmaker(autocommit=False, autoflush=False, bind=Engine, expire_on_commit=False)


class Base(DeclarativeBase):
    @classmethod
    def execute(cls, expression, session: Session = None):
        if session:
            return session.execute(expression)

        with SessionContext() as session:
            # Rows must be fetched before the session closes (AsyncSession does the same internally)
            return session.execute(expression, execution_options={'prebuffer_rows': True})


@contextmanager
def SessionContext() -> Session:
    session = SessionMaker()

    try:
        yield session
        session.commit()

    except Exception:
        session.rollback()
        logger.error(traceback.format_exc())
        raise

    finally:
        session.close()
