# Loading environments:
class Environment(BaseSettings):
    """
    Secrets and deployment-specific values. Read from environment variables or from BASE_DIR / '.env'
    (see .env.example; never commit .env).
    """
    model_config = SettingsConfigDict(env_file=BASE_DIR / '.env', env_file_encoding='utf-8', extra='ignore')

    DEBUG: bool = True
    BOT_TOKEN: str = ''
    DATABASE_CONNECT: str = 'postgresql+asyncpg://user:password@host:port/database'


env = Environment()


# Development variables:
DEBUG = env.DEBUG

# Applications:
